/**
 * Study Notes V2 — query/lookup service (STUDY-V2-001/002 foundation).
 * Reads window.STUDY_JURUSAN / window.STUDY_SUBJECTS (data/study-subjects.js)
 * and window.STUDY_RESOURCE_MANIFEST (data/study-resource-manifest.js,
 * generated by scripts/build-study-manifest.mjs). Pure read/query helpers —
 * no rendering, no navigation, no mutation of the manifest.
 *
 * INVARIANT (see data/study-subjects.js for the full statement): every query
 * here is scoped by jurusan/semester/subjectCode. There is deliberately no
 * "getResourcesByCollege(...)" or any function that lists resources grouped
 * by sourceCollege as a primary axis — sourceCollege is a per-resource
 * metadata field you can read off an item, never a query dimension this
 * service organizes results by. If a future change adds one, it is
 * reintroducing the "Study Notes grouped by Kolej" mistake the product
 * owner explicitly ruled out.
 *
 * Only resources with reviewStatus:"auto_parsed" AND moderationStatus that
 * is not "rejected" are considered "publishable" by getPublishableResources
 * below — manual_review items exist in the manifest (so nothing scanned is
 * silently lost) but are not shown in ordinary browse results until a human
 * reviews them. That review UI is out of scope for this stage (STUDY-V2-008).
 *
 * Must load after data/study-subjects.js and data/study-resource-manifest.js.
 */
(function () {
  function getManifest() {
    return Array.isArray(window.STUDY_RESOURCE_MANIFEST) ? window.STUDY_RESOURCE_MANIFEST : [];
  }

  function getJurusanList() {
    return Array.isArray(window.STUDY_JURUSAN) ? window.STUDY_JURUSAN : [];
  }

  function getJurusanById(jurusanId) {
    return getJurusanList().find(item => item.id === jurusanId) || null;
  }

  function getSubjects() {
    return Array.isArray(window.STUDY_SUBJECTS) ? window.STUDY_SUBJECTS : [];
  }

  function getSubjectsByJurusan(jurusanId) {
    return getSubjects().filter(subject => subject.jurusan === jurusanId);
  }

  function getSubjectsByJurusanAndSemester(jurusanId, semester) {
    const canonicalSemester = Number(semester);
    return getSubjectsByJurusan(jurusanId).filter(subject => subject.semester === canonicalSemester);
  }

  function getSubjectByCode(subjectCode) {
    return getSubjects().find(subject => subject.code === subjectCode) || null;
  }

  function isPublishable(resource) {
    return resource.reviewStatus === "auto_parsed" && resource.moderationStatus !== "rejected" && !resource.isDuplicate;
  }

  function getPublishableResources() {
    return getManifest().filter(isPublishable);
  }

  function getResourcesForSubject(subjectCode, { includeUnreviewed = false } = {}) {
    const pool = includeUnreviewed ? getManifest() : getPublishableResources();
    return pool.filter(resource => resource.subjectCode === subjectCode);
  }

  function getResourceCountForSubject(subjectCode) {
    return getResourcesForSubject(subjectCode).length;
  }

  function getResourceCountForJurusan(jurusanId) {
    return getPublishableResources().filter(resource => resource.jurusan === jurusanId).length;
  }

  function getTotalPublishableResourceCount() {
    return getPublishableResources().length;
  }

  function getManualReviewQueue() {
    return getManifest().filter(resource => resource.reviewStatus === "manual_review");
  }

  function getResourceById(resourceId) {
    return getManifest().find(resource => resource.id === resourceId) || null;
  }

  function getRelatedResource(resource) {
    if (!resource?.relatedResourceId) return null;
    return getResourceById(resource.relatedResourceId);
  }

  function getResourceGroup(resourceGroupId) {
    if (!resourceGroupId) return [];
    return getManifest().filter(resource => resource.resourceGroupId === resourceGroupId);
  }

  function searchResources(query, { includeUnreviewed = false } = {}) {
    const trimmed = String(query || "").trim().toLowerCase();
    if (!trimmed) return [];
    const pool = includeUnreviewed ? getManifest() : getPublishableResources();
    // Subject Code should match first/best, per spec section 9 ("Subject
    // Code 应优先匹配") — exact/prefix code matches are sorted ahead of
    // plain title/topic substring matches.
    const codeMatches = [];
    const otherMatches = [];
    for (const resource of pool) {
      const code = String(resource.subjectCode || "").toLowerCase();
      if (code && code.startsWith(trimmed)) { codeMatches.push(resource); continue; }
      const haystack = `${resource.title} ${resource.topic || ""}`.toLowerCase();
      if (haystack.includes(trimmed)) otherMatches.push(resource);
    }
    return [...codeMatches, ...otherMatches];
  }

  window.StudyResourceService = Object.freeze({
    getJurusanList,
    getJurusanById,
    getSubjects,
    getSubjectsByJurusan,
    getSubjectsByJurusanAndSemester,
    getSubjectByCode,
    getPublishableResources,
    getResourcesForSubject,
    getResourceCountForSubject,
    getResourceCountForJurusan,
    getTotalPublishableResourceCount,
    getManualReviewQueue,
    getResourceById,
    getRelatedResource,
    getResourceGroup,
    searchResources,
  });
})();
