/**
 * Study Notes V2 — query/lookup service (STUDY-V2-001/002 foundation).
 * Reads window.STUDY_JURUSAN / window.STUDY_SUBJECTS (data/study-subjects.js)
 * and window.STUDY_RESOURCE_MANIFEST (data/study-resource-manifest.js,
 * generated by scripts/build-study-manifest.mjs). Pure read/query helpers —
 * no rendering, no navigation, no mutation of the manifest.
 *
 * INVARIANT (see data/study-subjects.js for the full statement): every query
 * here is scoped by jurusan/semester/subjectCode. There is deliberately no
 * "getResourcesByCollege(...)" or any function that lists resources grouped
 * by sourceCollege as a primary axis — sourceCollege is a per-resource
 * metadata field you can read off an item, never a query dimension this
 * service organizes results by. If a future change adds one, it is
 * reintroducing the "Study Notes grouped by Kolej" mistake the product
 * owner explicitly ruled out.
 *
 * Only resources with reviewStatus:"auto_parsed" AND moderationStatus that
 * is not "rejected" are considered "publishable" by getPublishableResources
 * below — manual_review items exist in the manifest (so nothing scanned is
 * silently lost) but are not shown in ordinary browse results until a human
 * reviews them. That review UI is out of scope for this stage (STUDY-V2-008).
 *
 * Must load after data/study-subjects.js and data/study-resource-manifest.js.
 */
(function () {
  function getManifest() {
    return Array.isArray(window.STUDY_RESOURCE_MANIFEST) ? window.STUDY_RESOURCE_MANIFEST : [];
  }

  function getJurusanList() {
    return Array.isArray(window.STUDY_JURUSAN) ? window.STUDY_JURUSAN : [];
  }

  function getJurusanById(jurusanId) {
    return getJurusanList().find(item => item.id === jurusanId) || null;
  }

  function getSubjects() {
    return Array.isArray(window.STUDY_SUBJECTS) ? window.STUDY_SUBJECTS : [];
  }

  function getSubjectsByJurusan(jurusanId) {
    return getSubjects().filter(subject => subject.jurusan === jurusanId);
  }

  function getSubjectsByJurusanAndSemester(jurusanId, semester) {
    const canonicalSemester = Number(semester);
    return getSubjectsByJurusan(jurusanId).filter(subject => subject.semester === canonicalSemester);
  }

  function getSubjectByCode(subjectCode) {
    return getSubjects().find(subject => subject.code === subjectCode) || null;
  }

  function isPublishable(resource) {
    return resource.reviewStatus === "auto_parsed" && resource.moderationStatus !== "rejected" && !resource.isDuplicate;
  }

  function getPublishableResources() {
    return getManifest().filter(isPublishable);
  }

  function getResourcesForSubject(subjectCode, { includeUnreviewed = false } = {}) {
    const pool = includeUnreviewed ? getManifest() : getPublishableResources();
    return pool.filter(resource => resource.subjectCode === subjectCode);
  }

  // STUDY-V2-004: the Subject page must verify the resource actually
  // belongs to the jurusan+semester in the URL, not just match on
  // subjectCode alone (subjectCode happens to be unique per jurusan+
  // semester in this registry, but the resource's OWN jurusan/semester
  // fields are what's authoritative — trusting only subjectCode would
  // silently show a resource under the wrong Browse Hierarchy branch if
  // the manifest ever had a parsing mismatch).
  function getResourcesForSubjectInContext(jurusanId, semester, subjectCode, { includeUnreviewed = false } = {}) {
    const canonicalSemester = Number(semester);
    const pool = includeUnreviewed ? getManifest() : getPublishableResources();
    return pool.filter(resource => resource.jurusan === jurusanId && resource.semester === canonicalSemester && resource.subjectCode === subjectCode);
  }

  // STUDY-V2-004: the single place that maps a StudyResource's fine-grained
  // resourceType/resourceSubtype (kept exactly as parsed — see
  // scripts/build-study-manifest.mjs) onto the coarser browse categories
  // the spec's UI section asks for. Data layer taxonomy is NOT changed to
  // fit the UI — this is purely a display-time grouping.
  const RESOURCE_CATEGORY_ORDER = ["lecturer_notes", "student_notes", "pre_pra_pspm", "pspm", "answer_scheme", "practice", "lab", "summary", "other"];

  function getResourceCategory(resource) {
    if (resource.resourceType === "notes") {
      return resource.resourceSubtype === "lecturer_notes" ? "lecturer_notes" : "student_notes";
    }
    if (resource.resourceType === "answer_scheme") return "answer_scheme";
    if (resource.resourceType === "paper") {
      if (resource.resourceSubtype === "pre_pspm" || resource.resourceSubtype === "pra_pspm") return "pre_pra_pspm";
      return "pspm";
    }
    if (resource.resourceType === "practice") return "practice";
    if (resource.resourceType === "lab") return "lab";
    if (resource.resourceType === "summary") return "summary";
    return "other";
  }

  // Categories that are grouped by exam year in the UI (spec section 8) —
  // everything else renders as a flat, newest-metadata-first list.
  const YEAR_GROUPED_CATEGORIES = new Set(["pspm", "pre_pra_pspm"]);

  function isYearGroupedCategory(category) {
    return YEAR_GROUPED_CATEGORIES.has(category);
  }

  function getResourceCountForSubject(subjectCode) {
    return getResourcesForSubject(subjectCode).length;
  }

  function getResourceCountForJurusan(jurusanId) {
    return getPublishableResources().filter(resource => resource.jurusan === jurusanId).length;
  }

  // STUDY-V2-003: resource.semester is a real field on every StudyResource
  // (not derived from subjectCode here), so this filters the manifest
  // directly rather than summing per-subject counts — same accuracy, one
  // pass instead of N.
  function getResourceCountForJurusanSemester(jurusanId, semester) {
    const canonicalSemester = Number(semester);
    return getPublishableResources().filter(resource => resource.jurusan === jurusanId && resource.semester === canonicalSemester).length;
  }

  // Distinct resourceType values actually present among a subject's
  // publishable resources — never a fabricated/fixed category list, only
  // what getResourcesForSubject() really returns for that code.
  function getResourceTypesForSubject(subjectCode) {
    const types = new Set(getResourcesForSubject(subjectCode).map(resource => resource.resourceType));
    return [...types];
  }

  function getTotalPublishableResourceCount() {
    return getPublishableResources().length;
  }

  function getManualReviewQueue() {
    return getManifest().filter(resource => resource.reviewStatus === "manual_review");
  }

  function getResourceById(resourceId) {
    return getManifest().find(resource => resource.id === resourceId) || null;
  }

  function getRelatedResource(resource) {
    if (!resource?.relatedResourceId) return null;
    return getResourceById(resource.relatedResourceId);
  }

  function getResourceGroup(resourceGroupId) {
    if (!resourceGroupId) return [];
    return getManifest().filter(resource => resource.resourceGroupId === resourceGroupId);
  }

  // Exposed so Resource Detail (a direct-link surface, reachable without
  // going through a Subject list) can apply the exact same "hide
  // manual_review/rejected/duplicate from ordinary users" rule as every
  // list view — see the STUDY-V2-004 report for why this matters: without
  // this check, a stray/guessed resourceId could leak an unreviewed item.
  function isResourcePublishable(resource) {
    return Boolean(resource) && isPublishable(resource);
  }

  // STUDY-V2-006: the ONLY place that resolves a resource's public file URL.
  // app-study.js must never concatenate a path itself ("/study-files/" +
  // title etc.) — it always calls this. `fileUrl` is precomputed, static
  // data written by scripts/build-study-demo-files.mjs (repo-relative,
  // under assets/study-files/, named by resourceId — never the original
  // title/folder path), so there is no user input or request-time path
  // construction here to sanitize; the "no ../, no filesystem access via
  // query string" requirement is satisfied structurally, not by a runtime
  // check. Returns null for any resource not in the curated demo file set
  // (see `demoAvailable`) — callers must handle that as a real, honest
  // "not available" state, never as an error.
  function getResourceFileUrl(resource) {
    return resource && resource.fileUrl ? resource.fileUrl : null;
  }

  // Derived from the fileUrl's own extension — never guessed from the
  // title. Returns null when there is no file (mirrors getResourceFileUrl).
  function getResourceFileType(resource) {
    const url = getResourceFileUrl(resource);
    if (!url) return null;
    const ext = url.slice(url.lastIndexOf(".") + 1).toLowerCase();
    return ext || null;
  }

  function isResourceFilePdf(resource) {
    return getResourceFileType(resource) === "pdf";
  }

  function searchResources(query, { includeUnreviewed = false } = {}) {
    const trimmed = String(query || "").trim().toLowerCase();
    if (!trimmed) return [];
    const pool = includeUnreviewed ? getManifest() : getPublishableResources();
    // Subject Code should match first/best, per spec section 9 ("Subject
    // Code 应优先匹配") — exact/prefix code matches are sorted ahead of
    // plain title/topic substring matches.
    const codeMatches = [];
    const otherMatches = [];
    for (const resource of pool) {
      const code = String(resource.subjectCode || "").toLowerCase();
      if (code && code.startsWith(trimmed)) { codeMatches.push(resource); continue; }
      const haystack = `${resource.title} ${resource.topic || ""}`.toLowerCase();
      if (haystack.includes(trimmed)) otherMatches.push(resource);
    }
    return [...codeMatches, ...otherMatches];
  }

  window.StudyResourceService = Object.freeze({
    getJurusanList,
    getJurusanById,
    getSubjects,
    getSubjectsByJurusan,
    getSubjectsByJurusanAndSemester,
    getSubjectByCode,
    getPublishableResources,
    getResourcesForSubject,
    getResourcesForSubjectInContext,
    getResourceCategory,
    isYearGroupedCategory,
    RESOURCE_CATEGORY_ORDER,
    getResourceCountForSubject,
    getResourceCountForJurusan,
    getResourceCountForJurusanSemester,
    getResourceTypesForSubject,
    getTotalPublishableResourceCount,
    getManualReviewQueue,
    getResourceById,
    isResourcePublishable,
    getRelatedResource,
    getResourceGroup,
    getResourceFileUrl,
    getResourceFileType,
    isResourceFilePdf,
    searchResources,
  });
})();
