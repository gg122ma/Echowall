/**
 * Study Notes V2 module styles (STUDY-V2-FOUNDATION-001).
 * Deliberately reuses the existing .org-page/.selection-shell/.selection-list/
 * .selection-item/.org-header shell (already used by Community's College
 * Landing) for the Browse pages — no new list/card system was needed there.
 * The Homepage promo reuses .map-promo's structural CSS (style-core.css)
 * and only overrides color here, so Study Notes reads as EchoWall's
 * existing design language, not a new one — but it is explicitly its own
 * static, non-pointer-glow card (see the comment on .study-notes-promo
 * below), giving it a visual identity distinct from both the Community
 * Card (gold, pointer-follow) and the Echo Map promo (cyan-blue).
 */

/* Static on purpose — no pointer-follow glow, no JS. Study Notes is a
   distinct feature area from Community; it intentionally does not reuse
   .home-community-card's interactive glow system. */
.study-notes-promo::before { background: rgba(124,131,253,.16); }
.study-notes-promo .eyebrow { color: #b7bbff; }
:root[data-theme="dark"] .study-notes-promo .eyebrow { color: #c7caff; }

.study-hub-desc { color: var(--text-muted); font-size: .92rem; margin-top: 6px; max-width: 560px; }
:root[data-theme="dark"] .study-hub-desc { color: var(--text-muted); }

/* STUDY-V2-003: Semester picker (#/study/:jurusan). Only 2 items ever
   (Semester 1/2), so a small responsive grid — not the compact
   .selection-list used everywhere else in this module — gives it a bit
   more visual weight without introducing a new design language. Mirrors
   .org-card's existing light/dark background convention (hardcoded #fff,
   dark-theme override to var(--card-bg)) for consistency with the rest of
   the app rather than inventing a new theming approach. */
.study-semester-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; }
.study-semester-card { appearance: none; width: 100%; text-align: left; border: 1px solid var(--border); border-radius: 18px; padding: 22px 24px; background: #fff; cursor: pointer; display: flex; flex-direction: column; gap: 6px; box-shadow: var(--shadow); transition: transform .22s var(--ease-out), box-shadow .22s ease, border-color .22s ease; }
.study-semester-card:hover, .study-semester-card:focus-visible { transform: translateY(-3px); box-shadow: var(--shadow-lg); border-color: var(--primary-light); outline: none; }
.study-semester-card:focus-visible { box-shadow: var(--shadow-lg), 0 0 0 3px color-mix(in srgb, var(--primary) 25%, transparent); }
.study-semester-icon { font-size: 1.6rem; }
.study-semester-title { font-size: 1.15rem; font-weight: 800; letter-spacing: -.02em; }
.study-semester-card small { color: var(--text-muted); font-size: .82rem; }
:root[data-theme="dark"] .study-semester-card { background: var(--card-bg); }
:root[data-theme="dark"] .study-semester-card:hover, :root[data-theme="dark"] .study-semester-card:focus-visible { border-color: var(--primary); }
@media (max-width: 720px) { .study-semester-grid { grid-template-columns: 1fr; } }

/* Real, computed resourceType tags on a Subject's selection-item — see
   studyResourceTypeBadges() in app-study.js. Never present when a subject
   has zero publishable resources (nothing to compute from). */
.study-type-badges { display: block; color: var(--primary); font-weight: 700; margin-top: 2px; }
:root[data-theme="dark"] .study-type-badges { color: var(--primary-light); }
